# Special folders, created on first login and flagged with their SPECIAL-USE
mailbox Drafts {
  auto = subscribe
  special_use = \Drafts
}
mailbox Sent {
  auto = subscribe
  special_use = \Sent
}
mailbox Trash {
  auto = subscribe
  special_use = \Trash
}
mailbox Junk {
  auto = subscribe
  special_use = \Junk
}
